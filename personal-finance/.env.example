# Environment Configuration Template
# Copy this file to .env and fill in your values

# LLM Configuration
HERMES_URL=http://127.0.0.1:11434
LLM_TIMEOUT=30
LLM_MAX_TOKENS=150
LLM_TEMPERATURE=0.3

# Database Configuration
DATABASE_PATH=./storage/duck.db
DATABASE_BACKUP_PATH=./storage/backups/

# Data Directories
DATA_DIR=./data/
SAMPLE_DATA_DIR=./data/samples/
FORMS_DIR=./forms/
FORMS_OUTPUT_DIR=./forms/output/

# Import Configuration
IMPORT_RULES_FILE=./ledger/import_rules.yaml
LEDGER_FILE=./ledger/main.beancount

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Environment (development or production)
ENVIRONMENT=development

# Security Settings
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/finance.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Default Currency and Locale
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en_US
TIMEZONE=America/New_York

# Bank Connection Settings (if using APIs)
# These would be used for direct bank API connections
BANK_API_ENABLED=false
BANK_API_SANDBOX=true

# Plaid Configuration (optional)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# Alert and Notification Settings
ALERTS_ENABLED=false
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Budget and Goal Settings
BUDGET_ALERTS_ENABLED=true
BUDGET_THRESHOLD_WARNING=0.8
BUDGET_THRESHOLD_CRITICAL=0.95

# Data Retention Settings
TRANSACTION_RETENTION_DAYS=2555  # 7 years
LOG_RETENTION_DAYS=90
BACKUP_RETENTION_DAYS=365

# Performance Settings
BATCH_SIZE=1000
QUERY_TIMEOUT=30
MAX_CONCURRENT_IMPORTS=3

# Development Settings
DEBUG=false
TESTING=false
MOCK_LLM_RESPONSES=false